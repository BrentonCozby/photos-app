{
  "name": "photos-app-server",
  "version": "1.0.0",
  "description": "Server for the Photos App",
  "main": "index.ts",
  "scripts": {
    "start": "NODE_ENV=production ts-node -r tsconfig-paths/register index.ts",
    "start:dev": "NODE_ENV=development nodemon --ext 'js,ts,json' --swc -r tsconfig-paths/register index.ts",
    "check:arch": "depcruise . --config .dependency-cruiser.js",
    "check:types": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "precommit": "npm run lint",
    "postinstall": "npm run prisma:generate",
    "prisma:migrate": "dotenv -e ../.env -- npx prisma migrate dev",
    "prisma:validate": "dotenv -e ../.env -- npx prisma validate",
    "prisma:generate": "dotenv -e ../.env -- npx prisma generate",
    "prisma:db-pull": "dotenv -e ../.env -- npx prisma db pull",
    "prisma:studio": "dotenv -e ../.env -- npx prisma studio",
    "prisma:format": "dotenv -e ../.env -- npx prisma format",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest ./",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest ./ --watch"
  },
  "author": "Brenton Cozby",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@braintree/sanitize-url": "^7.1.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@swc/core": "^1.16.1",
    "@swc/helpers": "^0.5.23",
    "@types/cors": "^2.8.19",
    "@types/dotenv-flow": "^3.3.3",
    "@types/express": "^5.0.6",
    "@types/json-api-serializer": "^2.6.6",
    "@types/lodash": "^4.17.25",
    "@types/node": "^24.13.3",
    "@types/sanitize-html": "^2.16.1",
    "@types/stoppable": "^1.1.3",
    "cors": "^2.8.6",
    "cuid": "^3.0.0",
    "dotenv-cli": "^11.0.0",
    "dotenv-flow": "^4.1.0",
    "express": "^5.2.1",
    "express-oauth2-jwt-bearer": "^1.10.0",
    "helmet": "^8.3.0",
    "jimp": "^1.6.1",
    "json-api-serializer": "^2.7.0",
    "lodash": "^4.18.1",
    "multer": "^2.3.0",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4",
    "stoppable": "^1.1.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/supertest": "^7.2.1",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "jest": "^30.5.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12"
  }
}
